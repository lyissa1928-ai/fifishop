// ============================================================
// FIFISHOP - DATABASE SCHEMA V1
// Prisma 7.10 / PostgreSQL 16
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  CUSTOMER
  DELIVERY_AGENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  OUT_OF_STOCK
  ARCHIVED
}

enum ProductType {
  FOOD
  FASHION
  SHOES
  JEWELRY
  BAG_ACCESSORY
  VEHICLE
  OTHER
}

enum MeasurementUnit {
  PIECE
  KG
  HALF_KG
  GRAM
  LITER
  PACK
  CARTON
  CRATE
  PAIR
  UNIT
}

enum StockMovementType {
  INITIAL
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  DAMAGED
  CANCELLED_ORDER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  WAVE
  ORANGE_MONEY
  CASH_ON_DELIVERY
  BANK_CARD
  BANK_TRANSFER
}

enum DeliveryStatus {
  PENDING
  PREPARING
  READY
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
}

enum DeliveryMethod {
  HOME_DELIVERY
  PICKUP
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum VehicleFuel {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
  LPG
  OTHER
}

enum VehicleTransmission {
  MANUAL
  AUTOMATIC
  SEMI_AUTOMATIC
}

enum VehicleCondition {
  NEW
  USED
  RECONDITIONED
}

// ============================================================
// USERS / CUSTOMERS
// ============================================================

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  phone        String?    @unique
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole   @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)

  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?

  customerProfile CustomerProfile?
  addresses       Address[]
  carts           Cart[]
  orders          Order[]
  auditLogs       AuditLog[]
  refreshTokens   RefreshToken[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  assignedDeliveries Delivery[] @relation("DeliveryAgent")

  @@index([role])
  @@index([status])
  @@index([createdAt])
}

model CustomerProfile {
  id     String @id @default(cuid())
  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  dateOfBirth DateTime?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Address {
  id     String @id @default(cuid())
  userId String

  label        String?
  recipient    String
  phone        String
  country      String  @default("SÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©nÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©gal")
  region       String?
  city         String
  district     String?
  street       String?
  instructions String?

  isDefault Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([city])
}

// ============================================================
// CATALOG
// ============================================================

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  imageUrl    String?

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  products Product[]

  isActive Boolean @default(true)
  position Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([isActive])
  @@index([position])
}

model Product {
  id               String  @id @default(cuid())
  categoryId       String
  sku              String  @unique
  slug             String  @unique
  name             String
  description      String?
  shortDescription String?

  type   ProductType
  status ProductStatus @default(DRAFT)

  // XOF / FCFA : montants entiers
  price          Int
  compareAtPrice Int?
  costPrice      Int?
  currency       String @default("XOF")

  measurementUnit MeasurementUnit @default(PIECE)

  trackStock    Boolean @default(true)
  stockQuantity Decimal @default(0) @db.Decimal(12, 3)
  lowStockLevel Decimal @default(5) @db.Decimal(12, 3)

  featured Boolean @default(false)

  category Category @relation(fields: [categoryId], references: [id])

  images     ProductImage[]
  variants   ProductVariant[]
  stockMoves StockMovement[]

  foodDetails    FoodDetails?
  vehicleDetails VehicleDetails?
  fashionDetails FashionDetails?
  shoeDetails    ShoeDetails?
  jewelryDetails JewelryDetails?

  cartItems      CartItem[]
  orderItems     OrderItem[]
  promotionLinks PromotionProduct[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  @@index([categoryId])
  @@index([type])
  @@index([status])
  @@index([featured])
  @@index([createdAt])
  @@index([categoryId, status])
}

model ProductImage {
  id        String @id @default(cuid())
  productId String

  url       String
  altText   String?
  position  Int     @default(0)
  isPrimary Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([productId, position])
}

model ProductVariant {
  id        String @id @default(cuid())
  productId String

  sku  String  @unique
  name String?

  size     String?
  color    String?
  material String?

  price          Int?
  compareAtPrice Int?

  stockQuantity Decimal @default(0) @db.Decimal(12, 3)
  lowStockLevel Decimal @default(5) @db.Decimal(12, 3)
  isActive      Boolean @default(true)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  stockMoves StockMovement[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([isActive])
}

// ============================================================
// SPECIALIZED PRODUCT DETAILS
// ============================================================

model FoodDetails {
  id        String @id @default(cuid())
  productId String @unique

  origin       String?
  conservation String?
  preparation  String?

  soldByWeight Boolean  @default(false)
  minimumOrder Decimal? @db.Decimal(10, 3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model FashionDetails {
  id        String @id @default(cuid())
  productId String @unique

  gender     String?
  brand      String?
  fabric     String?
  care       String?
  collection String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ShoeDetails {
  id        String @id @default(cuid())
  productId String @unique

  gender   String?
  brand    String?
  material String?
  style    String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model JewelryDetails {
  id        String @id @default(cuid())
  productId String @unique

  jewelryType String?
  material    String?
  stone       String?
  weightGrams Decimal? @db.Decimal(10, 3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model VehicleDetails {
  id        String @id @default(cuid())
  productId String @unique

  brand String
  model String
  year  Int

  mileageKm Int?

  fuel         VehicleFuel
  transmission VehicleTransmission
  condition    VehicleCondition

  color        String?
  engine       String?
  doors        Int?
  seats        Int?
  registration String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([brand])
  @@index([year])
  @@index([condition])
}

// ============================================================
// INVENTORY
// ============================================================

model StockMovement {
  id        String  @id @default(cuid())
  productId String
  variantId String?

  type     StockMovementType
  quantity Decimal           @db.Decimal(12, 3)

  previousQuantity Decimal @db.Decimal(12, 3)
  newQuantity      Decimal @db.Decimal(12, 3)

  reason      String?
  reference   String?
  performedBy String?

  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([variantId])
  @@index([type])
  @@index([createdAt])
}

// ============================================================
// CART
// ============================================================

model Cart {
  id     String  @id @default(cuid())
  userId String?

  // Pour panier invitÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©
  sessionId String? @unique

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  productId String
  variantId String?

  quantity Decimal @db.Decimal(10, 3)

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cartId])
  @@index([productId])
  @@index([variantId])
}

// ============================================================
// ORDERS
// ============================================================

model Order {
  id             String  @id @default(cuid())
  orderNumber    String  @unique
  idempotencyKey String? @unique

  userId String?

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)

  currency String @default("XOF")

  subtotal       Int
  discountAmount Int @default(0)
  deliveryFee    Int @default(0)
  total          Int

  customerFirstName String
  customerLastName  String
  customerEmail     String?
  customerPhone     String

  notes String?

  user User? @relation(fields: [userId], references: [id])

  items     OrderItem[]
  addresses OrderAddress[]
  payments  Payment[]
  delivery  Delivery?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String

  productId String?
  variantId String?

  // Snapshot immuable de l'article au moment de la commande
  productName String
  productSku  String
  variantName String?

  unitPrice Int
  quantity  Decimal @db.Decimal(10, 3)
  lineTotal Int

  selectedOptions Json?

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model OrderAddress {
  id      String @id @default(cuid())
  orderId String

  type String

  recipient    String
  phone        String
  country      String  @default("SÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©nÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©gal")
  region       String?
  city         String
  district     String?
  street       String?
  instructions String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([orderId])
}

// ============================================================
// PAYMENTS
// ============================================================

model Payment {
  id      String @id @default(cuid())
  orderId String

  method PaymentMethod
  status PaymentStatus @default(PENDING)

  amount   Int
  currency String @default("XOF")

  providerTransactionId String? @unique
  providerReference     String?

  paidAt   DateTime?
  failedAt DateTime?

  // DonnÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©es techniques non sensibles du fournisseur
  metadata Json?

  order Order @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([method])
}

// ============================================================
// DELIVERY
// ============================================================

model Delivery {
  id      String @id @default(cuid())
  orderId String @unique

  method DeliveryMethod
  status DeliveryStatus @default(PENDING)

  zone String?
  fee  Int     @default(0)

  carrierName  String?
  trackingCode String? @unique

  scheduledAt DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?

  notes String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  deliveryAgentId String?
  deliveryAgent   User?   @relation("DeliveryAgent", fields: [deliveryAgentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([deliveryAgentId])
}

// ============================================================
// PROMOTIONS
// ============================================================

model Promotion {
  id   String  @id @default(cuid())
  name String
  code String? @unique

  type  PromotionType
  value Int

  minimumOrderAmount Int?
  maximumDiscount    Int?

  startsAt DateTime
  endsAt   DateTime?

  usageLimit Int?
  usageCount Int  @default(0)

  isActive Boolean @default(true)

  products PromotionProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([startsAt])
  @@index([endsAt])
}

model PromotionProduct {
  promotionId String
  productId   String

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@index([productId])
}

// ============================================================
// AUDIT
// ============================================================

model AuditLog {
  id String @id @default(cuid())

  userId String?

  action     String
  entityType String
  entityId   String?

  ipAddress String?
  userAgent String?

  oldValues Json?
  newValues Json?
  metadata  Json?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
}

model RefreshToken {
  id        String @id @default(cuid())
  userId    String
  tokenHash String @unique

  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model DeliveryZone {
  id String @id @default(cuid())

  name String
  slug String @unique

  fee Int

  freeDeliveryThreshold Int?

  estimatedMinDays Int?
  estimatedMaxDays Int?

  isActive Boolean @default(true)
  position Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([position])
}
